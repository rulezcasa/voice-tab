# Copy to .env and fill in. Never commit .env.

# --- Superlinked SIE (all model inference) ---
SL_BASE_URL=
SL_API_KEY=

# --- SingleStore (ledger + memory) ---
# From the workspace's Connect panel in the SingleStore portal.
SS_HOST=
SS_PORT=3306
SS_USER=
SS_PASSWORD=
SS_DATABASE=tab
# Optional SELECT-only user for the agent's text-to-SQL queries (recommended):
#   CREATE USER 'tab_ro'@'%' IDENTIFIED BY '...';  GRANT SELECT ON tab.* TO 'tab_ro'@'%';
SS_READONLY_USER=
SS_READONLY_PASSWORD=

# --- App ---
# Time zone used to resolve "today", "last Wednesday", etc.
TZ=America/Los_Angeles
DEFAULT_CURRENCY=USD

# --- Optional add-ons (leave blank unless used) ---
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=

# --- Private agent links (python -m scripts.agent_links) ---
# Signs each person's private link. Use a long random string; changing it invalidates every link.
AGENT_LINK_SECRET=
