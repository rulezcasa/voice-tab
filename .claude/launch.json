{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd app && .venv/bin/fastapi dev main.py --port 8000"],
      "port": 8000
    },
    {
      "name": "backend-testdb",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd app && SS_DATABASE=tab_meetups_test .venv/bin/fastapi dev main.py --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd webapp && npm run dev -- --port 5173"],
      "port": 5173
    }
  ]
}
