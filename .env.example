# Copy to .env and fill in. Never commit .env.

# --- Superlinked SIE (all model inference) ---
SIE_BASE_URL=
SIE_API_KEY=

# --- SingleStore (ledger + memory) ---
S2_HOST=
S2_PORT=3306
S2_USER=
S2_PASSWORD=
S2_DB=tab

# --- App ---
# Time zone used to resolve "today", "last Wednesday", etc.
TZ=America/Los_Angeles
DEFAULT_CURRENCY=USD

# --- Optional add-ons (leave blank unless used) ---
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
